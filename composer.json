{
    "name": "lenorix/beel-sdk",
    "type": "library",
    "description": "Unofficial community PHP SDK for the BeeL invoicing API",
    "keywords": [
        "api-client",
        "beel",
        "lenorix",
        "beel-sdk",
        "invoicing",
        "php-sdk",
        "verifactu"
    ],
    "homepage": "https://github.com/lenorix/BeeL-php-sdk",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/lenorix/BeeL-php-sdk/issues",
        "source": "https://github.com/lenorix/BeeL-php-sdk"
    },
    "authors": [
        {
            "name": "Jesus Hernandez",
            "email": "jesushdez@protonmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^8.2",
        "jane-php/open-api-runtime": "^7.14",
        "php": "^8.4",
        "php-http/client-common": "^2.0",
        "php-http/discovery": "^1.6",
        "psr/http-client": "^1.0",
        "symfony/serializer": "^5.4 || ^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "jane-php/open-api-3": "^7.14",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.1",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Lenorix\\BeelSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lenorix\\BeelSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php -d memory_limit=512M vendor/bin/pest --no-coverage",
        "test-coverage": "vendor/bin/pest --coverage",
        "pint": "vendor/bin/pint src/Beel.php src/Builder src/Exception src/Http src/Resource src/Webhook tests",
        "format": "vendor/bin/pint src/Beel.php src/Builder src/Exception src/Http src/Resource src/Webhook tests",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M",
        "generate": "@php bin/prepare-openapi.php && php -d memory_limit=256M vendor/bin/jane-openapi generate"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    }
}
